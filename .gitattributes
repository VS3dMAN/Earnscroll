# Auto-detect text files and normalise line endings to LF in the repo
* text=auto

# Force these to always use LF (Gradle / shell scripts)
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
gradlew text eol=lf

# Force CRLF for Windows-only files
*.bat text eol=crlf

# Binary files — don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.apk binary
*.aab binary
*.mov binary
*.mp4 binary
